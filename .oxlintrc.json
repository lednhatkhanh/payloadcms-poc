{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "nextjs", "jsx-a11y", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "settings": {
    "next": {
      "rootDir": ["apps/web", "apps/cms"]
    }
  },
  "rules": {
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    ".agents/**",
    ".next/**",
    "node_modules/**",
    "packages/payload-config/src/generated/**"
  ]
}
